{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.+\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^better-auth$": "<rootDir>/src/auth/__mocks__/better-auth.js",
    "^better-auth/node$": "<rootDir>/src/auth/__mocks__/better-auth-node.js",
    "^better-auth/plugins$": "<rootDir>/src/auth/__mocks__/better-auth-plugins.js",
    "^better-auth-mikro-orm$": "<rootDir>/src/auth/__mocks__/better-auth-mikro-orm.js"
  }
}
