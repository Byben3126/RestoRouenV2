{
  "moduleFileExtensions": ["js", "mjs", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.+\\.integration-spec\\.ts$",
  "maxWorkers": 1,
  "testTimeout": 30000,
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+\\.m?js$": ["babel-jest", { "rootMode": "upward" }]
  },
  "transformIgnorePatterns": ["/node_modules/(?!@thallesp/nestjs-better-auth/)"],
  "moduleNameMapper": {
    "^better-auth$": "<rootDir>/src/modules/auth/__mocks__/better-auth.js",
    "^better-auth/api$": "<rootDir>/src/modules/auth/__mocks__/better-auth-api.js",
    "^better-auth/node$": "<rootDir>/src/modules/auth/__mocks__/better-auth-node.js",
    "^better-auth/plugins$": "<rootDir>/src/modules/auth/__mocks__/better-auth-plugins.js",
    "^better-auth-mikro-orm$": "<rootDir>/src/modules/auth/__mocks__/better-auth-mikro-orm.js"
  }
}
